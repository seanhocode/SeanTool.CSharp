<Window x:Class="SeanTool.CSharp.WPFTool.Test.DropDownListTestWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SeanTool.CSharp.WPFTool.Test"
        xmlns:WPFTool="clr-namespace:SeanTool.CSharp.WPFTool.UserControls.DropDownList;assembly=WPFTool"
        mc:Ignorable="d"
        Title="DropDownListTestWindow" Height="450" Width="500"
        Background="{DynamicResource ApplicationBackgroundBrush}">
    <StackPanel Margin="12">
        <TextBlock Text="單選 DropDownList (支援搜尋)" Margin="0,0,0,4" />
        <WPFTool:DropDownList x:Name="SinglePersonDropDown"
            ItemsSource="{Binding PersonList}"
            DisplayMemberPath="Name"
            PlaceholderText="請選擇人員" />

        <TextBlock Text="多選 DropDownList (支援搜尋)" Margin="0,20,0,4" />
        <WPFTool:DropDownList x:Name="MultiPersonDropDown"
            ItemsSource="{Binding PersonList}"
            DisplayMemberPath="Name"
            SelectionMode="Multiple"
            PlaceholderText="請選擇人員(可多選)" />

        <Button Content="顯示單選結果" Click="ShowSingleSelection" Height="30" Margin="0,20,0,0" />
        <Button Content="顯示多選結果" Click="ShowMultiSelection" Height="30" Margin="0,8,0,0" />
        <Button Content="清除多選" Click="ClearMultiSelection" Height="30" Margin="0,8,0,0" />
        <Button Content="新增一位人員(測試動態來源)" Click="AddPerson" Height="30" Margin="0,8,0,0" />
    </StackPanel>
</Window>
