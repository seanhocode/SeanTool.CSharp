<!--
    參考 ModelEditorTestWindow.xaml 的 Step 1~3，額外示範 ModelEditor 繫結 DataTable 單一列(DataRowView)：
    Step.1 加入WPFTool參考(行:8)
    Step.2 嵌入ModelEditorView(行:22)
    Step.3 設定TargetObject綁定為 DataTable 的單一列(DataRowView)，於.cs初始化時設定this.DataContext = this;
-->
<Window x:Class="SeanTool.CSharp.WPFTool.Test.ModelEditorDataTableTestWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SeanTool.CSharp.WPFTool.Test"
        xmlns:WPFTool="clr-namespace:SeanTool.CSharp.WPFTool.UserControls.ModelEditor;assembly=WPFTool"
        mc:Ignorable="d"
        Title="ModelEditorDataTableTestWindow" Height="450" Width="800"
        Background="{DynamicResource ApplicationBackgroundBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- TargetObject 直接繫結 DataTable，ModelEditor 內部會自動轉為其 DefaultView 的第一列(DataRowView)並透過共用 FieldAnalyzer 掃描欄位 -->
        <WPFTool:ModelEditor Grid.Row="0" TargetObject="{Binding PersonTable}" />

        <Button Grid.Row="1" Click="CheckModelValue" Height="30" Margin="5">CheckValue</Button>
    </Grid>
</Window>
