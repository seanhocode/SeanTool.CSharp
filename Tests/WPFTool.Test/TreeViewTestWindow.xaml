<Window x:Class="SeanTool.CSharp.WPFTool.Test.TreeViewTestWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:SeanTool.CSharp.WPFTool.UserControls.VirtualTreeView;assembly=WPFTool"
        Title="TreeViewTestWindow" Height="600" Width="800"
        Background="{DynamicResource ApplicationBackgroundBrush}">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <controls:VirtualTreeView x:Name="SchoolTreeView"
                        Grid.Row="0"
                        ItemsSource="{Binding RootNodes}" />
        <Button Grid.Row="1"
                Height="30"
                Margin="0,8,0,0"
                Click="ShowCheckedItems">顯示勾選項目</Button>
    </Grid>
</Window>
