<UserControl x:Class="SeanTool.CSharp.WPF.DataTimePicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="180">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="88" />
        </Grid.ColumnDefinitions>
        <DatePicker x:Name="DatePickerControl"
                SelectedDateChanged="DatePickerChanged" />
        <TextBox x:Name="TimeTextBox"
                 Grid.Column="1"
                 Margin="5,0,0,0"
                 TextChanged="TimeTextChanged"
                 ToolTip="格式: HH:mm 或 HH:mm:ss"
                 VerticalContentAlignment="Center" />
        <TextBlock Grid.ColumnSpan="2"
                   Margin="2,27,0,0"
                   Foreground="Firebrick"
                   Text="{Binding ErrorMessage, RelativeSource={RelativeSource AncestorType=UserControl}}"
                   TextWrapping="Wrap" />
    </Grid>
</UserControl>
