<UserControl x:Class="SeanTool.CSharp.WPF.DynamicDataGridFilterControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SeanTool.CSharp.WPF"
             MinWidth="120">
    <UserControl.Resources>
        <DataTemplate x:Key="DateTimeValueTemplate">
            <local:DataTimePicker SelectedDateTime="{Binding DateTimeValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        </DataTemplate>
    </UserControl.Resources>
    <Border Padding="3" BorderBrush="#D0D0D0" BorderThickness="0,1,0,0">
        <StackPanel>
            <TextBlock Text="{Binding Header}" HorizontalAlignment="Center" />
            <ComboBox ItemsSource="{Binding Source={x:Static local:DynamicDataGridFilterControl.FilterOperators}}"
                      SelectedItem="{Binding Operator, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <ContentControl Content="{Binding}">
                <ContentControl.Style>
                    <Style TargetType="ContentControl">
                        <Setter Property="ContentTemplate">
                            <Setter.Value>
                                <DataTemplate>
                                    <TextBox Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="輸入篩選值" />
                                </DataTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsDateTime}" Value="True">
                                <Setter Property="ContentTemplate" Value="{StaticResource DateTimeValueTemplate}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ContentControl.Style>
            </ContentControl>
                <Button Content="查詢"
                    Command="{Binding ApplyCommand}"
                    Margin="0,3,0,0"
                    Padding="8,2" />
        </StackPanel>
    </Border>
</UserControl>