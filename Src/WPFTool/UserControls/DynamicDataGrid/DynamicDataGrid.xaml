<UserControl x:Class="SeanTool.CSharp.WPFTool.UserControls.DynamicDataGrid.DynamicDataGrid"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SeanTool.CSharp.WPFTool.UserControls.DynamicDataGrid"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800"
             VerticalAlignment="Stretch"
             MinHeight="0"
             Background="{DynamicResource ApplicationBackgroundBrush}">
    <UserControl.Resources>
        <ResourceDictionary>
            <!--套用 Theme.xaml-->
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/WPFTool;component/Styles/Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <WrapPanel Grid.Row="0" Margin="4">
            <Button Content="清除所有篩選"
                  Padding="12,2"
                  Click="ClearFilter" />

            <!--<CheckBox Content="顯示勾選欄"
                    Margin="16,0,0,0"
                    IsChecked="{Binding ShowCheckBox, RelativeSource={RelativeSource AncestorType={x:Type local:DynamicDataGrid}}, Mode=TwoWay}"
                    VerticalAlignment="Center" />-->
        </WrapPanel>

        <Border Grid.Row="1" Margin="4">
            <!--
                VirtualizationMode="Recycling"（維持預設）：
                歷史筆記 - 曾因列勾選 CheckBox 套用 WPF-UI 內建動畫樣板，Recycling 模式下
                row container 被回收重綁定資料時，動畫 clock 對已被清空的值求值，
                拋出 ArgumentNullException (defaultDestinationValue)，故一度改用 Standard 迴避。
                根因修復已全域套用（見 Styles\WPFUICheckBox.xaml 覆蓋 WPF-UI 預設 CheckBox 樣式），
                不再套用 WPF-UI 的動畫樣板，因此 Recycling 模式下不會再觸發同一問題，
                已改回 Recycling 以恢復其虛擬化效能優勢（減少大量捲動時的容器配置與 GC 壓力）。
            -->
            <DataGrid x:Name="MainDataGrid"
                    MinHeight="0"
                    VerticalAlignment="Stretch"
                    Background="Transparent"
                    BorderThickness="0"
                    AutoGenerateColumns="False"
                    CanUserAddRows="False"
                    CanUserDeleteRows="False"
                    EnableRowVirtualization="True"
                    EnableColumnVirtualization="True"
                    ScrollViewer.CanContentScroll="True"
                    VirtualizingPanel.IsVirtualizing="True"
                    VirtualizingPanel.VirtualizationMode="Recycling"
                    VirtualizingPanel.ScrollUnit="Pixel">
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
