<UserControl x:Class="SeanTool.CSharp.WPFTool.UserControls.DateTimePicker.DateTimePicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="180"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/WPFTool;component/Styles/Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <!-- No custom rounded-container style: relies on WPF-UI's ControlsDictionary for control appearance -->
    <Border>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <DatePicker x:Name="DatePickerControl"
                Background="Transparent"
                BorderThickness="0"
                SelectedDateChanged="DatePickerChanged" />

            <Border Grid.Column="1"
                    Width="1"
                    Background="{DynamicResource DividerStrokeColorDefaultBrush}" />

            <TextBox x:Name="TimeTextBox"
                     Grid.Column="2"
                     Background="Transparent"
                     BorderThickness="0"
                     LostFocus="TimeTextLostFocus"
                     TextChanged="TimeTextChanged"
                     ToolTip="格式: HH:mm 或 HH:mm:ss"
                     VerticalContentAlignment="Center" />
        </Grid>
    </Border>
</UserControl>
