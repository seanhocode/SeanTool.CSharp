<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="Brush.Surface" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brush.Surface.Subtle" Color="#F5F5F5" />
    <SolidColorBrush x:Key="Brush.Border" Color="#CCCCCC" />
    <SolidColorBrush x:Key="Brush.Border.Subtle" Color="#DDDDDD" />
    <SolidColorBrush x:Key="Brush.Text" Color="#333333" />
    <SolidColorBrush x:Key="Brush.Text.Muted" Color="#AAAAAA" />
    <SolidColorBrush x:Key="Brush.Text.OnAccent" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brush.Accent" Color="#0078D4" />
    <SolidColorBrush x:Key="Brush.Accent.Hover" Color="#0063B1" />
    <SolidColorBrush x:Key="Brush.Accent.Pressed" Color="#004C87" />
    <SolidColorBrush x:Key="Brush.Control.Hover" Color="#E0E0E0" />
    <SolidColorBrush x:Key="Brush.Control.Pressed" Color="#D0D0D0" />
    <SolidColorBrush x:Key="Brush.Control.Disabled" Color="#F5F5F5" />
    <SolidColorBrush x:Key="Brush.DataGrid.Header" Color="#0078D4" />
    <SolidColorBrush x:Key="Brush.DataGrid.RowAlternate" Color="#F8FAFC" />
    <SolidColorBrush x:Key="Brush.DataGrid.RowHover" Color="#EAF4FF" />
    <SolidColorBrush x:Key="Brush.DataGrid.RowSelected" Color="#DCEEFF" />
    <SolidColorBrush x:Key="Brush.Error" Color="Firebrick" />
</ResourceDictionary>
